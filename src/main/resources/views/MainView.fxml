<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="550.0" minWidth="850.0" prefHeight="650.0" prefWidth="950.0" stylesheets="@../styles/application.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.student.movieapp.controller.MainController">
   <top>
      <VBox BorderPane.alignment="CENTER">
         <children>
            <!-- Header Title Bar -->
            <VBox styleClass="header-box">
               <children>
                  <Label styleClass="header-title" text="MOVIE WATCHLIST MANAGER" />
                  <Label styleClass="header-subtitle" text="Organize, track, and manage your favorite movies" />
               </children>
            </VBox>

            <!-- Filter Controls Bar -->
            <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="filter-panel">
               <children>
                  <Label styleClass="label-filter" text="Genre:" />
                  <ComboBox fx:id="genreFilterBox" prefWidth="140.0" promptText="All Genres" />

                  <Label styleClass="label-filter" text="Status:">
                     <HBox.margin>
                        <Insets left="8.0" />
                     </HBox.margin>
                  </Label>
                  <ComboBox fx:id="statusFilterBox" prefWidth="150.0" promptText="All Statuses" />

                  <Label styleClass="label-filter" text="Date Added:">
                     <HBox.margin>
                        <Insets left="8.0" />
                     </HBox.margin>
                  </Label>
                  <DatePicker fx:id="dateFilterPicker" prefWidth="140.0" promptText="Pick a date" />

                  <Button mnemonicParsing="false" onAction="#handleFilter" styleClass="btn-primary" text="Filter" />
                  <Button mnemonicParsing="false" onAction="#handleRefresh" styleClass="btn-secondary" text="Clear Filters" />
               </children>
            </HBox>
         </children>
      </VBox>
   </top>

   <!-- Center TableView -->
   <center>
      <TableView fx:id="movieTableView" prefHeight="400.0" prefWidth="950.0" BorderPane.alignment="CENTER">
        <columns>
          <TableColumn fx:id="titleCol" prefWidth="250.0" text="Title" />
          <TableColumn fx:id="genreCol" prefWidth="130.0" text="Genre" />
          <TableColumn fx:id="yearCol" prefWidth="100.0" text="Release Year" />
          <TableColumn fx:id="ratingCol" prefWidth="90.0" text="Rating" />
          <TableColumn fx:id="statusCol" prefWidth="150.0" text="Status" />
          <TableColumn fx:id="dateCol" prefWidth="140.0" text="Date Added" />
        </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
   </center>

   <!-- Bottom Action Controls & Status -->
   <bottom>
      <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="action-panel" BorderPane.alignment="CENTER">
         <children>
            <Button mnemonicParsing="false" onAction="#handleAddMovie" styleClass="btn-primary" text="+ Add Movie" />
            <Button mnemonicParsing="false" onAction="#handleEditMovie" styleClass="btn-secondary" text="Edit" />
            <Button mnemonicParsing="false" onAction="#handleDeleteMovie" styleClass="btn-danger" text="Delete" />
            <Button mnemonicParsing="false" onAction="#handleRefresh" styleClass="btn-secondary" text="Refresh" />

            <!-- Spacer pushes Total Movies counter to the right -->
            <Pane HBox.hgrow="ALWAYS" />

            <Label fx:id="totalMoviesLabel" styleClass="total-label" text="Total Movies: 0" />
         </children>
      </HBox>
   </bottom>
</BorderPane>
